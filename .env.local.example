# Supabase project of SaxSteps (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser: used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Lemon Squeezy: the checkout link of the product variant (Products > Share)
# and the signing secret of the webhook (Settings > Webhooks).
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
